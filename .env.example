# Copy this file to .env and pick ONE provider.

# Option 1 (default): Ollama, runs locally and is free. Install from https://ollama.com, then: ollama pull llama3.2
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Option 2: Groq, free API tier and very fast. Get a key at https://console.groq.com
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-key-here
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low

# Option 3: OpenAI (paid)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Option 4: no LLM, shows the best matching passage only
# LLM_PROVIDER=none

# Optional tuning
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# TOP_K=4

# Chat attachments: voice notes (Whisper) and screenshots (vision model) run on Groq and need GROQ_API_KEY.
# Text files (.txt, .log, .csv, .json, ...) and PDFs are read locally.
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=en
# VISION_MODEL=qwen/qwen3.8-27b

# Login. The built-in admin account; CHANGE THE PASSWORD before you share the app.
# Employees create their own accounts on the login page (saved, hashed, in logs/users.json).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# ADMIN_DISPLAY_NAME=Adarsh Sharma
# LOGIN_HOURS=12

# Branding: the assistant's name and who it says founded it
# BOT_NAME=IT Helpdesk Assistant
# FOUNDER_NAME=Adarsh Sharma

# Default website colors (admins can change them in Admin → Website colors without touching code)
# USER_THEME_COLOR=#2563eb
# ADMIN_THEME_COLOR=#7c3aed
