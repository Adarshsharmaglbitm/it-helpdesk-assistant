# Copy this file to .env and pick ONE provider.

# Option 1 (default): Ollama, runs locally and is free. Install from https://ollama.com, then: ollama pull llama3.2
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Option 2: Groq, free API tier and very fast. Get a key at https://console.groq.com
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-key-here
# GROQ_MODEL=llama-3.1-8b-instant

# Option 3: OpenAI (paid)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Option 4: no LLM, shows the best matching passage only
# LLM_PROVIDER=none

# Optional tuning
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# TOP_K=4
